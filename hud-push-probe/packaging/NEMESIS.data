[nemesis]
version=1.1
id=k5.hud.probe
name=K5 HUD + AA Method Trace Probe
package-version=1.4
short-desc=Read-only Android Auto navigation callback method trace
detailed-desc=90-second sample profiler for AA/GPM. No changes to OEM system or projection files.
type=application,service
os=*V039.001.260902
models=DL3HEV*
preinstall=scripts/check.sh

[app.0]
kind=apk
path=app/K5HUDPushProbe.apk
package=kr.k5.hudprobe
component=kr.k5.hudprobe/.MainActivity

[service.0]
name=aa-log-recorder
kind=sh
path=svc/aa_capture.sh
uid=root
mode=restart
